# =============================================================================
# ORCA Backend — Environment Variables
# Copy this file to .env and fill in the values.
# =============================================================================

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=true

# --- Mock Flags ---
# Set to "true" to use synthetic/mock data instead of live API calls.
# Agents without valid credentials will automatically fall back to mock mode.
MOCK_SST_CHLOROPHYLL=false
MOCK_MARINE_WEATHER=false
MOCK_CYCLONE_DISASTER=false
MOCK_LIGHTNING=true
MOCK_TIDE=false
MOCK_VESSEL_AIS=true
MOCK_GEOFENCE=false
MOCK_PFZ_SYNTHESIS=false
MOCK_COPERNICUS=false

# --- API Keys (Required for live mode) ---

# AISstream.io — real-time AIS vessel positions (free signup at aisstream.io)
AISSTREAM_API_KEY=

# Global Fishing Watch — fishing effort data (free non-commercial at globalfishingwatch.org)
GFW_API_TOKEN=

# ProtectedPlanet/WDPA — marine protected areas (free at protectedplanet.net)
WDPA_API_TOKEN=

# Bhashini/ULCA — Indian language ASR/MT/TTS (free PoC at bhashini.gov.in)
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# LLM for chatbot (default: Anthropic Claude)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514

# Copernicus Marine Service — global waves, physics, thetao (free at marine.copernicus.eu, no quotas)
# Official toolbox looks for COPERNICUSMARINE_SERVICE_* or COPERNICUS_* env vars
COPERNICUSMARINE_SERVICE_USERNAME=anarayan123
COPERNICUSMARINE_SERVICE_PASSWORD=
COPERNICUS_USERNAME=anarayan123
COPERNICUS_PASSWORD=

# --- External API URLs (configurable, defaults are correct for most cases) ---
ERDDAP_BASE_URL=https://coastwatch.pfeg.noaa.gov/erddap
OPEN_METEO_MARINE_URL=https://marine-api.open-meteo.com/v1/marine
OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
NDBC_BASE_URL=https://www.ndbc.noaa.gov/data/realtime2
GDACS_FEED_URL=https://www.gdacs.org/xml/rss.xml
AISSTREAM_WS_URL=wss://stream.aisstream.io/v0/stream
GFW_API_URL=https://gateway.api.globalfishingwatch.org
BHASHINI_API_URL=https://meity-auth.ulcacontrib.org
GEBCO_WMS_URL=https://wms.gebco.net/mapserv

# --- Data Paths (relative to project root) ---
EEZ_DATA_PATH=data/eez_boundaries
MPA_DATA_PATH=data/mpa
BATHYMETRY_DATA_PATH=data/bathymetry
SEED_DATA_PATH=data/seed

# --- Grid / Routing Config ---
GRID_RESOLUTION=0.1
REROUTE_COST_THRESHOLD=0.5

# --- Default Harbor (Kochi) ---
DEFAULT_HARBOR_LAT=9.9312
DEFAULT_HARBOR_LON=76.2673
